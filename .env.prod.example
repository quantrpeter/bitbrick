# Copy to .env.prod (git-ignored) and fill in. Never commit real values.
# Start with:  docker compose --env-file .env.prod -f docker-compose-prod.yml up -d

APP_NAME=BitBrick
APP_URL=https://bitbrick.example.com
# docker run --rm quantrpeter/bitbrick:1.0 php artisan key:generate --show
APP_KEY=

# Generate each with: openssl rand -base64 24
DB_DATABASE=bitbrick
DB_USERNAME=bitbrick
DB_PASSWORD=
DB_ROOT_PASSWORD=
# MySQL, the app and phpMyAdmin all read these four from here (docker-compose-prod.yml holds no credentials).

# Google OAuth client created for BitBrick only (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bitbrick.example.com/auth/google/callback

# TLS is terminated in front of the container. Use the proxy's address, or * if it is not reachable from elsewhere.
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

# Administrators (comma separated Google addresses), promoted when they sign in.
# Or create one from the server: docker compose exec app php artisan bitbrick:make-admin you@gmail.com
BITBRICK_ADMIN_EMAILS=

# Password of the seeded administrator peter@quantr.hk. Applied by `php artisan db:seed` (username: admin).
# Or set any user's password later: docker compose exec app php artisan bitbrick:set-password you@example.com
BITBRICK_ADMIN_PASSWORD=

# Optional private beta: only these e-mail domains may sign in (comma separated).
BITBRICK_ALLOWED_DOMAINS=

BITBRICK_VERSION=1.0
